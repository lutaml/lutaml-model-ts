{
  "name": "lutaml-model-ts",
  "version": "0.0.0",
  "private": true,
  "description": "Typed TypeScript target for LutaML Model LML documents",
  "type": "module",
  "license": "BSD-2-Clause",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./exact": {
      "types": "./dist/codecs/exact.d.ts",
      "default": "./dist/codecs/exact.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "lutaml-model-ts": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest"
  },
  "dependencies": {
    "moxml-ts": "git+https://github.com/lutaml/moxml-ts.git#78801e0641cbaf5e5feb3a651446b72c01b70d0a",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
